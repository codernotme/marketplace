APP_NAME=theMrktPlace Backend
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081

MONGO_MASTER_URI=mongodb://localhost:27017
MONGO_SHARED_URI=mongodb://localhost:27017
MONGO_MASTER_DB=mrkt_master
MONGO_SHARED_DB=mrkt_shared
MONGO_MAX_POOL_SIZE=200
MONGO_MIN_POOL_SIZE=5

JWT_SECRET_KEY=change-me-in-production
JWT_REFRESH_SECRET_KEY=change-me-in-production-refresh
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=15

# Base64-encoded 32-byte key. Example generation:
# python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

DEFAULT_FROM_EMAIL=no-reply@themrktplace.com
RESEND_API_BASE=https://api.resend.com
RAZORPAY_API_BASE=https://api.razorpay.com/v1

TELEGRAM_WEBHOOK_SECRET=change-me-telegram-webhook-secret
