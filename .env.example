# -----------------------------------------------------------------------------
# THEMRKTPLACE - ENVIRONMENT VARIABLES REFERENCE
# -----------------------------------------------------------------------------
# This file serves as a comprehensive guide to all environment variables
# required to run the platform (API + Dashboard + Workers) across environments.
# 
# Copy this file to `.env` in the root directory before starting docker-compose.
# -----------------------------------------------------------------------------

# ==============================================================================
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ==============================================================================
# The primary database URL used by Prisma.
# For local Docker setup: postgresql://postgres:postgres@localhost:5432/themrktplace?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/themrktplace?schema=public"

# (Optional) Direct database URL for migrations if using connection pooling (e.g. PgBouncer)
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/themrktplace?schema=public"

# ==============================================================================
# 2. REDIS CONFIGURATION (Caching, Sessions & Background Jobs)
# ==============================================================================
# Used by BullMQ (workers), session stores, and rate limiting.
REDIS_URL="redis://localhost:6379/0"

# ==============================================================================
# 3. TYPESENSE CONFIGURATION (Search Engine)
# ==============================================================================
# Used for lightning-fast product/inventory search on POS and Dashboard.
TYPESENSE_API_KEY="testing-key-123"
TYPESENSE_HOST="localhost"
TYPESENSE_PORT="8108"
TYPESENSE_PROTOCOL="http"

# ==============================================================================
# 4. API & DASHBOARD URLs
# ==============================================================================
# Next.js Dashboard URL (Used for CORS and email links)
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
DASHBOARD_URL="http://localhost:3000"

# Fastify API Server Settings
PORT=3001
HOST="0.0.0.0"

# ==============================================================================
# 5. SECURITY & AUTHENTICATION
# ==============================================================================
# Secret used to sign JWT tokens. MUST be long and random in production.
JWT_SECRET="super-secret-key-change-me-in-production-12345"

# ==============================================================================
# 6. EXTERNAL SERVICES & INTEGRATIONS
# ==============================================================================
# Resend API Key for transactional emails (Auth, Low Stock Alerts, Invoices)
RESEND_API_KEY="re_123456789"
EMAIL_FROM="noreply@themrktplace.com"

# AWS S3 (or compatible) for Media/Image Uploads (Products, Store Logos)
AWS_ACCESS_KEY_ID="your_access_key"
AWS_SECRET_ACCESS_KEY="your_secret_key"
AWS_REGION="ap-south-1"
S3_BUCKET_NAME="themrktplace-media"

# ==============================================================================
# 7. POS SPECIFIC SETTINGS
# ==============================================================================
# Optional: Enforce strict IP whitelisting for POS terminals in stores
# POS_ALLOWED_IPS="192.168.1.1,203.0.113.5"
