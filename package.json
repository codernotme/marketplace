{
  "name": "themrktplace",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:api": "turbo dev --filter=@themrktplace/api",
    "dev:storefront": "turbo dev --filter=storefront",
    "pos": "cd apps/pos && flutter run",
    "pos:windows": "cd apps/pos && flutter run -d windows",
    "db:generate": "turbo prisma:generate",
    "db:push": "turbo db:push",
    "db:seed": "turbo db:seed",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@workspace/eslint-config": "*",
    "@workspace/typescript-config": "*",
    "cross-env": "^10.1.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tsx": "^4.21.0",
    "turbo": "^2.8.17",
    "typescript": "5.9.3"
  },
  "packageManager": "npm@11.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  }
}
