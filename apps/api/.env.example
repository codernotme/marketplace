# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/themrktplace"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
JWT_REFRESH_SECRET="change-this-to-a-different-long-random-secret"
APP_SECRET="change-this-to-a-32-byte-hex-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
HOST="0.0.0.0"
NODE_ENV="development"

# ─── Cloudflare R2 ────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# ─── Resend (email) ───────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="noreply@themrktplace.com"

# ─── MSG91 (SMS) ─────────────────────────────────────────────────────────────
MSG91_AUTH_KEY=""
MSG91_SENDER_ID="MRKPLC"
MSG91_TEMPLATE_ID=""

# ─── Typesense ────────────────────────────────────────────────────────────────
TYPESENSE_URL="http://localhost:8108"
TYPESENSE_API_KEY="change-this-master-key"

# ─── App ──────────────────────────────────────────────────────────────────────
DASHBOARD_URL="http://localhost:3000"
STOREFRONT_URL="http://localhost:3002"
