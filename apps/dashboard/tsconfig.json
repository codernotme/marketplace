{
  "extends": "@workspace/typescript-config/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@modules/*": ["./modules/*"],
      "@components/*": ["./components/*"],
      "@lib/*": ["./lib/*"],
      "@workspace/ui/*": ["../../packages/ui/src/*"],
      "@themrktplace/schema": ["../../packages/schema/src/index.ts"],
      "@themrktplace/types": ["../../packages/types/src/index.ts"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
