# Backend API
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_DIRECT_API=false

# App Configuration
NEXT_PUBLIC_APP_NAME=theMrktPlace
NEXT_PUBLIC_APP_DESCRIPTION=SaaS Marketplace Platform
NEXT_PUBLIC_PLAN_FREE_MODULES=shop
NEXT_PUBLIC_PLAN_STARTER_MODULES=shop
NEXT_PUBLIC_PLAN_INTERMEDIATE_MODULES=shop,web
NEXT_PUBLIC_PLAN_GROWTH_MODULES=shop,web,app
NEXT_PUBLIC_PLAN_ENTERPRISE_MODULES=shop,web,app

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
