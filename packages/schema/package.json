{
  "name": "@themrktplace/schema",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./zod/*": "./src/zod/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate --schema=src/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=src/prisma/schema.prisma"
  },
  "dependencies": {
    "zod": "^3.25.76",
    "@prisma/client": "^6.7.0"
  },
  "devDependencies": {
    "@workspace/typescript-config": "*",
    "prisma": "^6.7.0",
    "typescript": "^5.9.3"
  }
}
