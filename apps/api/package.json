{
  "name": "@themrktplace/api",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node --esm src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate --schema=../../packages/schema/src/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=../../packages/schema/src/prisma/schema.prisma"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.800.0",
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.1",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^3.1.0",
    "@prisma/client": "^6.7.0",
    "@themrktplace/schema": "workspace:*",
    "@themrktplace/types": "workspace:*",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.4.0",
    "csv-parse": "^6.2.1",
    "csv-stringify": "^6.7.0",
    "fastify": "^5.8.5",
    "fastify-socket.io": "^4.0.0",
    "ioredis": "^5.6.1",
    "next": "16.2.4",
    "qrcode": "^1.5.4",
    "resend": "^4.5.1",
    "speakeasy": "^2.0.0",
    "typesense": "^3.0.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/csv-parse": "^1.2.5",
    "@types/node": "^25.1.0",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "@workspace/typescript-config": "workspace:*",
    "nodemon": "^3.1.10",
    "prisma": "^6.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
