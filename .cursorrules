## CODING PATTERNS — ALWAYS FOLLOW THESE

### Router structure
```python
from fastapi import APIRouter, Depends, HTTPException, BackgroundTasks
from core.dependencies import get_tenant, get_current_user, require_role, get_tenant_config
from core.database import get_db
from models.product import ProductCreate, ProductResponse
from services.telegram_service import TelegramService

router = APIRouter(prefix="/products", tags=["products"])

@router.post("/", response_model=ProductResponse, status_code=201)
async def create_product(
    data: ProductCreate,
    background_tasks: BackgroundTasks,
    tenant = Depends(get_tenant),
    user = Depends(require_role(["shop_admin", "manager"])),
    db = Depends(get_db),
):
    tenant_id = str(tenant["_id"])
    # business logic here
    ...
```

### Always use background tasks for side effects
```python
# Don't await emails/Telegram inline — use background tasks
background_tasks.add_task(email_service.send_order_confirmation, order, config)
background_tasks.add_task(telegram_service.send_order_alert, order, config)
```

### Inventory deduction with safety
```python
async def deduct_inventory(items: list, order_id: ObjectId, tenant_id: str, db):
    for item in items:
        result = await db.products.update_one(
            {
                "_id": ObjectId(item.product_id),
                "tenant_id": ObjectId(tenant_id),
                "stock": {"$gte": item.quantity}  # atomic check + deduct
            },
            {"$inc": {"stock": -item.quantity}}
        )
        if result.modified_count == 0:
            # Stock ran out between validation and deduction
            # Roll back already-deducted items, cancel order
            await rollback_inventory(...)
            raise InsufficientStockError(item.product_id)
        # Log inventory change
        await db.inventory_logs.insert_one({
            "tenant_id": ObjectId(tenant_id),
            "product_id": ObjectId(item.product_id),
            "type": "sale",
            "quantity_change": -item.quantity,
            "reference_id": order_id,
            "created_by": "system",
            "created_at": datetime.utcnow()
        })
```

### Pagination pattern
```python
# utils/pagination.py
class PaginationParams:
    def __init__(self, page: int = 1, limit: int = 20):
        self.page = max(1, page)
        self.limit = min(100, max(1, limit))
        self.skip = (self.page - 1) * self.limit

# In router:
async def list_orders(pagination = Depends(PaginationParams), ...):
    total = await db.orders.count_documents(query)
    items = await db.orders.find(query).skip(pagination.skip).limit(pagination.limit).to_list(None)
    return {"items": items, "total": total, "page": pagination.page, "limit": pagination.limit}
```

### Slug generation (unique per tenant)
```python
# utils/slug.py
async def generate_unique_slug(title: str, tenant_id: str, db, collection: str) -> str:
    base = slugify(title)  # "My Product Name" → "my-product-name"
    slug = base
    counter = 1
    while await db[collection].find_one({"slug": slug, "tenant_id": ObjectId(tenant_id)}):
        slug = f"{base}-{counter}"
        counter += 1
    return slug
```

