// ─────────────────────────────────────────────────────────────────────────────
// Admin App — Master Prisma Schema (Single-Store eCommerce)
// Source of truth: all migrations run from this app only.
// ─────────────────────────────────────────────────────────────────────────────
generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// STORE CONFIG (single row — replaces Tenant in multi-tenant design)
// ─────────────────────────────────────────────────────────────────────────────

model StoreConfig {
  id              String   @id @default(cuid())
  name            String
  tagline         String?
  email           String?
  phone           String?
  logoUrl         String?
  faviconUrl      String?
  primaryColor    String?
  fontFamily      String?
  customCss       String?
  timezone        String   @default("UTC")
  currency        String   @default("INR")
  language        String   @default("en")
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?
  country         String?
  postalCode      String?
  privacyPolicy   String?
  termsOfService  String?
  refundPolicy    String?
  cookiePolicy    String?
  returnWindowDays Int     @default(14)
  autoApproveReturns Boolean @default(false)
  allowCustomerReturns Boolean @default(true)
  reviewAutoApprove Boolean @default(false)
  sessionTimeoutMinutes Int @default(120)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("store_config")
}

// ─────────────────────────────────────────────────────────────────────────────
// ADMIN AUTH (Better Auth — for admin panel users)
// ─────────────────────────────────────────────────────────────────────────────

model AdminUser {
  id            String        @id @default(cuid())
  email         String        @unique
  name          String
  role          AdminRole     @default(UNASSIGNED)
  image         String?
  phone         String?
  emailVerified Boolean       @default(false)
  twoFactorEnabled Boolean    @default(false)
  isActive      Boolean       @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sessions      AdminSession[]
  accounts      AdminAccount[]
  auditLogs     AuditLog[]
  assignedTickets SupportTicket[] @relation("AssignedAgent")
  createdTicketMessages TicketMessage[]
  notes         CustomerNote[]

  @@map("admin_users")
}

model AdminSession {
  id        String    @id @default(cuid())
  expiresAt DateTime
  token     String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("admin_sessions")
}

model AdminAccount {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("admin_accounts")
}

model AdminVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("admin_verifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// CUSTOMER AUTH (Better Auth — for storefront / ecom app customers)
// ─────────────────────────────────────────────────────────────────────────────

model Customer {
  id              String            @id @default(cuid())
  email           String            @unique
  name            String
  phone           String?
  image           String?
  emailVerified   Boolean           @default(false)
  marketingOptIn  Boolean           @default(false)
  dateOfBirth     DateTime?
  status          CustomerStatus    @default(ACTIVE)
  totalSpent      Decimal           @default(0) @db.Decimal(12, 2)
  ordersCount     Int               @default(0)
  ltv             Decimal           @default(0) @db.Decimal(12, 2)
  banReason       String?
  bannedAt        DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  sessions        CustomerSession[]
  accounts        CustomerAccount[]
  verifications   CustomerVerification[]
  addresses       CustomerAddress[]
  orders          Order[]
  reviews         Review[]
  wishlistItems   WishlistItem[]
  loyaltyPoints   LoyaltyPoint?
  loyaltyHistory  LoyaltyTransaction[]
  giftCardUsages  GiftCardUsage[]
  notes           CustomerNote[]
  segments        CustomerSegment[]  @relation("CustomerToSegment")
  tags            CustomerTag[]
  supportTickets  SupportTicket[]

  @@map("customers")
}

model CustomerSession {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  customerId String
  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_sessions")
}

model CustomerAccount {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  customerId            String
  customer              Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([customerId])
  @@map("customer_accounts")
}

model CustomerVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([identifier])
  @@map("customer_verifications")
}

model CustomerAddress {
  id           String   @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label        String?
  firstName    String
  lastName     String
  company      String?
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  country      String
  postalCode   String
  phone        String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([customerId])
  @@map("customer_addresses")
}

model CustomerNote {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  authorId   String
  author     AdminUser @relation(fields: [authorId], references: [id])
  body       String
  createdAt  DateTime  @default(now())

  @@map("customer_notes")
}

model CustomerTag {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag        String

  @@unique([customerId, tag])
  @@map("customer_tags")
}

model CustomerSegment {
  id          String     @id @default(cuid())
  name        String
  description String?
  rules       Json
  customerCount Int      @default(0)
  lastUpdatedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  customers   Customer[] @relation("CustomerToSegment")

  @@map("customer_segments")
}

// ─────────────────────────────────────────────────────────────────────────────
// CATALOG — Categories, Brands, Tags
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?
  parentId    String?
  parent      Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryChildren")
  sortOrder   Int        @default(0)
  seoTitle    String?
  seoDesc     String?
  isActive    Boolean    @default(true)
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("categories")
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  logoUrl     String?
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("brands")
}

model Tag {
  id       String     @id @default(cuid())
  name     String     @unique
  products ProductTag[]

  @@map("tags")
}

// ─────────────────────────────────────────────────────────────────────────────
// PRODUCTS
// ─────────────────────────────────────────────────────────────────────────────

model Product {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  shortDescription String?
  description      String?
  categoryId       String?
  category         Category?        @relation(fields: [categoryId], references: [id])
  brandId          String?
  brand            Brand?           @relation(fields: [brandId], references: [id])
  taxClassId       String?
  taxClass         TaxClass?        @relation(fields: [taxClassId], references: [id])
  vendorId         String?
  vendor           Vendor?          @relation(fields: [vendorId], references: [id])
  basePrice        Decimal          @db.Decimal(12, 2)
  compareAtPrice   Decimal?         @db.Decimal(12, 2)
  costPrice        Decimal?         @db.Decimal(12, 2)
  isTaxable        Boolean          @default(true)
  isFeatured       Boolean          @default(false)
  isDigital        Boolean          @default(false)
  trackInventory   Boolean          @default(true)
  allowBackorders  Boolean          @default(false)
  soldIndividually Boolean          @default(false)
  weight           Decimal?         @db.Decimal(10, 3)
  weightUnit       String?
  length           Decimal?         @db.Decimal(10, 2)
  width            Decimal?         @db.Decimal(10, 2)
  height           Decimal?         @db.Decimal(10, 2)
  dimensionUnit    String?
  shippingClassId  String?
  seoTitle         String?
  seoDescription   String?
  status           ProductStatus    @default(DRAFT)
  publishedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  variants         ProductVariant[]
  images           ProductImage[]
  options          ProductOption[]
  tags             ProductTag[]
  reviews          Review[]
  wishlistItems    WishlistItem[]
  orderItems       OrderItem[]
  relatedTo        ProductRelation[] @relation("RelatedFrom")
  relatedFrom      ProductRelation[] @relation("RelatedTo")

  @@map("products")
}

model ProductVariant {
  id             String      @id @default(cuid())
  productId      String
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String      @unique
  barcode        String?
  optionValues   Json
  price          Decimal?    @db.Decimal(12, 2)
  compareAtPrice Decimal?    @db.Decimal(12, 2)
  costPrice      Decimal?    @db.Decimal(12, 2)
  imageUrl       String?
  quantity       Int         @default(0)
  reservedQty    Int         @default(0)
  lowStockThreshold Int      @default(5)
  reorderPoint   Int         @default(10)
  reorderQty     Int         @default(50)
  weight         Decimal?    @db.Decimal(10, 3)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  orderItems     OrderItem[]
  inventoryMovements InventoryMovement[]
  purchaseOrderItems PurchaseOrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)

  @@index([productId])
  @@map("product_images")
}

model ProductOption {
  id        String               @id @default(cuid())
  productId String
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int                  @default(0)
  values    ProductOptionValue[]

  @@index([productId])
  @@map("product_options")
}

model ProductOptionValue {
  id       String        @id @default(cuid())
  optionId String
  option   ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  value    String
  sortOrder Int          @default(0)

  @@map("product_option_values")
}

model ProductTag {
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@map("product_tags")
}

model ProductRelation {
  fromProductId String
  fromProduct   Product @relation("RelatedFrom", fields: [fromProductId], references: [id], onDelete: Cascade)
  toProductId   String
  toProduct     Product @relation("RelatedTo", fields: [toProductId], references: [id], onDelete: Cascade)
  type          String  @default("related") // related, upsell, crosssell

  @@id([fromProductId, toProductId, type])
  @@map("product_relations")
}

model WishlistItem {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  addedAt    DateTime @default(now())

  @@unique([customerId, productId])
  @@map("wishlist_items")
}

model TaxClass {
  id       String    @id @default(cuid())
  name     String
  products Product[]

  @@map("tax_classes")
}

// ─────────────────────────────────────────────────────────────────────────────
// INVENTORY
// ─────────────────────────────────────────────────────────────────────────────

model Warehouse {
  id           String              @id @default(cuid())
  name         String
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String?
  postalCode   String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  isDefault    Boolean             @default(false)
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  movements    InventoryMovement[]
  purchaseOrders PurchaseOrder[]

  @@map("warehouses")
}

model InventoryMovement {
  id          String       @id @default(cuid())
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  warehouseId String?
  warehouse   Warehouse?   @relation(fields: [warehouseId], references: [id])
  type        MovementType
  quantityDelta Int
  quantityBefore Int
  quantityAfter  Int
  reason      String?
  referenceId String?
  referenceType String?
  performedById String?
  createdAt   DateTime     @default(now())

  @@index([variantId])
  @@map("inventory_movements")
}

model Supplier {
  id            String          @id @default(cuid())
  name          String
  contactName   String?
  email         String?
  phone         String?
  addressLine1  String?
  city          String?
  country       String?
  paymentTerms  String?
  notes         String?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model PurchaseOrder {
  id            String              @id @default(cuid())
  supplierId    String
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  warehouseId   String?
  warehouse     Warehouse?          @relation(fields: [warehouseId], references: [id])
  status        POStatus            @default(DRAFT)
  expectedAt    DateTime?
  receivedAt    DateTime?
  notes         String?
  totalCost     Decimal             @default(0) @db.Decimal(12, 2)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  items         PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id            String         @id @default(cuid())
  purchaseOrderId String
  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  orderedQty    Int
  receivedQty   Int            @default(0)
  unitCost      Decimal        @db.Decimal(12, 2)

  @@map("purchase_order_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────────────────────────────────────

model Order {
  id               String          @id @default(cuid())
  orderNumber      String          @unique
  customerId       String?
  customer         Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  guestEmail       String?
  guestName        String?
  guestPhone       String?
  paymentStatus    PaymentStatus   @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  channel          String          @default("web")
  couponId         String?
  coupon           Coupon?         @relation(fields: [couponId], references: [id])
  shippingRateId   String?
  shippingRate     ShippingRate?   @relation(fields: [shippingRateId], references: [id])
  subtotal         Decimal         @db.Decimal(12, 2)
  discountTotal    Decimal         @default(0) @db.Decimal(12, 2)
  shippingTotal    Decimal         @default(0) @db.Decimal(12, 2)
  taxTotal         Decimal         @default(0) @db.Decimal(12, 2)
  total            Decimal         @db.Decimal(12, 2)
  currency         String          @default("INR")
  shippingAddressId String?
  billingAddressId  String?
  shippingAddress  OrderAddress?   @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddress   OrderAddress?   @relation("BillingAddress", fields: [billingAddressId], references: [id])
  paymentMethod    String?
  paymentReference String?
  riskScore        Int?
  riskLevel        String?
  internalNote     String?
  isArchived       Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  items            OrderItem[]
  fulfillments     Fulfillment[]
  returns          Return[]
  transactions     Transaction[]
  timeline         OrderTimeline[]
  tags             OrderTag[]

  @@index([customerId])
  @@map("orders")
}

model OrderAddress {
  id              String  @id @default(cuid())
  firstName       String
  lastName        String
  company         String?
  addressLine1    String
  addressLine2    String?
  city            String
  state           String
  country         String
  postalCode      String
  phone           String?
  shippingOrders  Order[] @relation("ShippingAddress")
  billingOrders   Order[] @relation("BillingAddress")

  @@map("order_addresses")
}

model OrderItem {
  id            String         @id @default(cuid())
  orderId       String
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product        @relation(fields: [productId], references: [id])
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  productName   String
  variantLabel  String?
  sku           String
  quantity      Int
  unitPrice     Decimal        @db.Decimal(12, 2)
  discount      Decimal        @default(0) @db.Decimal(12, 2)
  taxAmount     Decimal        @default(0) @db.Decimal(12, 2)
  totalPrice    Decimal        @db.Decimal(12, 2)
  fulfillmentStatus String     @default("unfulfilled")
  returnItems   ReturnItem[]

  @@index([orderId])
  @@map("order_items")
}

model OrderTag {
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tag     String

  @@id([orderId, tag])
  @@map("order_tags")
}

model OrderTimeline {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventType String
  message   String
  userId    String?
  isInternal Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("order_timeline")
}

// ─────────────────────────────────────────────────────────────────────────────
// FULFILLMENT
// ─────────────────────────────────────────────────────────────────────────────

model Fulfillment {
  id            String            @id @default(cuid())
  orderId       String
  order         Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier       String?
  trackingNumber String?
  trackingUrl   String?
  status        String            @default("fulfilled")
  shippedAt     DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  items         FulfillmentItem[]

  @@index([orderId])
  @@map("fulfillments")
}

model FulfillmentItem {
  id             String      @id @default(cuid())
  fulfillmentId  String
  fulfillment    Fulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  orderItemId    String
  quantity       Int

  @@map("fulfillment_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// RETURNS & REFUNDS
// ─────────────────────────────────────────────────────────────────────────────

model Return {
  id             String       @id @default(cuid())
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id])
  customerId     String?
  status         ReturnStatus @default(REQUESTED)
  reason         String
  customerNote   String?
  staffNotes     String?
  rejectedReason String?
  refundMethod   String?
  refundAmount   Decimal?     @db.Decimal(12, 2)
  requestedAt    DateTime     @default(now())
  approvedAt     DateTime?
  receivedAt     DateTime?
  resolvedAt     DateTime?
  items          ReturnItem[]

  @@index([orderId])
  @@map("returns")
}

model ReturnItem {
  id          String    @id @default(cuid())
  returnId    String
  return      Return    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  quantity    Int
  condition   String?
  restocked   Boolean   @default(false)

  @@map("return_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// SHIPPING
// ─────────────────────────────────────────────────────────────────────────────

model ShippingZone {
  id        String         @id @default(cuid())
  name      String
  countries String[]
  regions   String[]
  isActive  Boolean        @default(true)
  rates     ShippingRate[]

  @@map("shipping_zones")
}

model ShippingRate {
  id               String       @id @default(cuid())
  zoneId           String
  zone             ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  name             String
  type             String       // flat, weight_based, price_based, free
  price            Decimal      @db.Decimal(10, 2)
  minOrderValue    Decimal?     @db.Decimal(10, 2)
  maxOrderValue    Decimal?     @db.Decimal(10, 2)
  minWeight        Decimal?     @db.Decimal(10, 3)
  maxWeight        Decimal?     @db.Decimal(10, 3)
  carrier          String?
  estimatedDaysMin Int?
  estimatedDaysMax Int?
  isActive         Boolean      @default(true)
  orders           Order[]

  @@map("shipping_rates")
}

// ─────────────────────────────────────────────────────────────────────────────
// TAX
// ─────────────────────────────────────────────────────────────────────────────

model TaxRate {
  id        String   @id @default(cuid())
  name      String
  country   String
  state     String?
  zip       String?
  rate      Decimal  @db.Decimal(6, 4)
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)

  @@map("tax_rates")
}

// ─────────────────────────────────────────────────────────────────────────────
// PROMOTIONS
// ─────────────────────────────────────────────────────────────────────────────

model Coupon {
  id                    String     @id @default(cuid())
  code                  String     @unique
  type                  CouponType
  value                 Decimal    @db.Decimal(10, 2)
  maxDiscount           Decimal?   @db.Decimal(10, 2)
  minOrderValue         Decimal?   @db.Decimal(10, 2)
  usageLimit            Int?
  usageCount            Int        @default(0)
  usageLimitPerCustomer Int?
  appliesTo             String     @default("order")
  productIds            String[]
  categoryIds           String[]
  customerIds           String[]
  firstTimeOnly         Boolean    @default(false)
  combineDiscounts      Boolean    @default(false)
  startsAt              DateTime?
  expiresAt             DateTime?
  isActive              Boolean    @default(true)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  orders                Order[]

  @@map("coupons")
}

model GiftCard {
  id                    String          @id @default(cuid())
  code                  String          @unique
  initialValue          Decimal         @db.Decimal(10, 2)
  balance               Decimal         @db.Decimal(10, 2)
  expiresAt             DateTime?
  isActive              Boolean         @default(true)
  purchasedByCustomerId String?
  recipientEmail        String?
  createdAt             DateTime        @default(now())
  usages                GiftCardUsage[]

  @@map("gift_cards")
}

model GiftCardUsage {
  id         String    @id @default(cuid())
  giftCardId String
  giftCard   GiftCard  @relation(fields: [giftCardId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  orderId    String?
  amount     Decimal   @db.Decimal(10, 2)
  usedAt     DateTime  @default(now())

  @@map("gift_card_usages")
}

model FlashSale {
  id          String   @id @default(cuid())
  name        String
  startsAt    DateTime
  endsAt      DateTime
  discountPct Decimal  @db.Decimal(5, 2)
  maxUnits    Int?
  productIds  String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("flash_sales")
}

// ─────────────────────────────────────────────────────────────────────────────
// LOYALTY
// ─────────────────────────────────────────────────────────────────────────────

model LoyaltyPoint {
  id         String   @id @default(cuid())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  balance    Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@map("loyalty_points")
}

model LoyaltyTransaction {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  points      Int
  type        String   // earn, redeem, expire, adjust
  description String?
  orderId     String?
  createdAt   DateTime @default(now())

  @@index([customerId])
  @@map("loyalty_transactions")
}

// ─────────────────────────────────────────────────────────────────────────────
// REVIEWS
// ─────────────────────────────────────────────────────────────────────────────

model Review {
  id         String       @id @default(cuid())
  productId  String
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  rating     Int
  title      String?
  body       String?
  status     ReviewStatus @default(PENDING)
  isVerifiedPurchase Boolean @default(false)
  storeReply String?
  repliedAt  DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([productId])
  @@map("reviews")
}

// ─────────────────────────────────────────────────────────────────────────────
// SUPPORT & HELPDESK
// ─────────────────────────────────────────────────────────────────────────────

model SupportTicket {
  id           String          @id @default(cuid())
  ticketNumber String          @unique
  subject      String
  customerId   String?
  customer     Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedToId String?
  assignedTo   AdminUser?      @relation("AssignedAgent", fields: [assignedToId], references: [id])
  orderId      String?
  channel      String          @default("web")
  priority     TicketPriority  @default(NORMAL)
  status       TicketStatus    @default(OPEN)
  tags         String[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  messages     TicketMessage[]

  @@index([customerId])
  @@map("support_tickets")
}

model TicketMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  body      String
  isInternal Boolean      @default(false)
  adminId   String?
  admin     AdminUser?    @relation(fields: [adminId], references: [id])
  customerId String?
  createdAt  DateTime     @default(now())

  @@index([ticketId])
  @@map("ticket_messages")
}

model CannedResponse {
  id        String   @id @default(cuid())
  title     String
  body      String
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("canned_responses")
}

// ─────────────────────────────────────────────────────────────────────────────
// VENDORS (within-store marketplace, optional)
// ─────────────────────────────────────────────────────────────────────────────

model Vendor {
  id             String       @id @default(cuid())
  name           String
  email          String       @unique
  phone          String?
  companyName    String?
  taxId          String?
  bankDetails    Json?
  commissionRate Decimal      @default(10) @db.Decimal(5, 2)
  status         VendorStatus @default(PENDING)
  autoApproveProducts Boolean @default(false)
  payoutBalance  Decimal      @default(0) @db.Decimal(12, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  products       Product[]

  @@map("vendors")
}

// ─────────────────────────────────────────────────────────────────────────────
// FINANCE
// ─────────────────────────────────────────────────────────────────────────────

model Transaction {
  id          String          @id @default(cuid())
  orderId     String?
  order       Order?          @relation(fields: [orderId], references: [id])
  type        TransactionType
  amount      Decimal         @db.Decimal(12, 2)
  currency    String          @default("INR")
  status      String          @default("completed")
  reference   String?
  gateway     String?
  gatewayRef  String?
  createdAt   DateTime        @default(now())

  @@index([orderId])
  @@map("transactions")
}

model Payout {
  id         String       @id @default(cuid())
  amount     Decimal      @db.Decimal(12, 2)
  currency   String       @default("INR")
  method     String?
  status     PayoutStatus @default(PENDING)
  reference  String?
  bankAccount String?
  note       String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@map("payouts")
}

model Expense {
  id          String   @id @default(cuid())
  category    String
  description String?
  amount      Decimal  @db.Decimal(12, 2)
  receiptUrl  String?
  date        DateTime
  createdAt   DateTime @default(now())

  @@map("expenses")
}

// ─────────────────────────────────────────────────────────────────────────────
// CMS — Pages, Blog, Navigation, Banners
// ─────────────────────────────────────────────────────────────────────────────

model CmsPage {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  body        String?
  seoTitle    String?
  seoDesc     String?
  status      PageStatus @default(DRAFT)
  scheduledAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("cms_pages")
}

model BlogCategory {
  id    String     @id @default(cuid())
  name  String
  slug  String     @unique
  posts BlogPost[]

  @@map("blog_categories")
}

model BlogPost {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  body        String?
  excerpt     String?
  featureImage String?
  categoryId  String?
  category    BlogCategory? @relation(fields: [categoryId], references: [id])
  authorId    String?
  seoTitle    String?
  seoDesc     String?
  status      PageStatus   @default(DRAFT)
  views       Int          @default(0)
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("blog_posts")
}

model NavigationMenu {
  id    String               @id @default(cuid())
  name  String               @unique
  items NavigationMenuItem[]

  @@map("navigation_menus")
}

model NavigationMenuItem {
  id       String             @id @default(cuid())
  menuId   String
  menu     NavigationMenu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  label    String
  url      String?
  pageId   String?
  type     String             @default("url")
  parentId String?
  parent   NavigationMenuItem? @relation("MenuItemChildren", fields: [parentId], references: [id])
  children NavigationMenuItem[] @relation("MenuItemChildren")
  sortOrder Int               @default(0)

  @@index([menuId])
  @@map("navigation_menu_items")
}

model Banner {
  id           String    @id @default(cuid())
  title        String
  subtitle     String?
  imageUrl     String
  ctaText      String?
  ctaUrl       String?
  position     String    @default("hero")
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("banners")
}

model Announcement {
  id             String   @id @default(cuid())
  message        String
  bgColor        String?
  showCloseButton Boolean @default(true)
  isActive       Boolean  @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("announcements")
}

// ─────────────────────────────────────────────────────────────────────────────
// MARKETING — Email Campaigns
// ─────────────────────────────────────────────────────────────────────────────

model EmailCampaign {
  id             String           @id @default(cuid())
  name           String
  subject        String
  previewText    String?
  body           String?
  segmentId      String?
  status         CampaignStatus   @default(DRAFT)
  sentCount      Int              @default(0)
  openCount      Int              @default(0)
  clickCount     Int              @default(0)
  scheduledAt    DateTime?
  sentAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("email_campaigns")
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS & AUDIT
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id         String           @id @default(cuid())
  userId     String?
  type       NotificationType
  title      String
  message    String
  link       String?
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([userId])
  @@map("notifications")
}

model AuditLog {
  id           String    @id @default(cuid())
  userId       String?
  user         AdminUser? @relation(fields: [userId], references: [id])
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AutomationRule {
  id          String   @id @default(cuid())
  name        String
  trigger     String
  condition   Json?
  action      String
  actionConfig Json?
  isActive    Boolean  @default(true)
  lastTriggeredAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("automation_rules")
}

model Webhook {
  id        String   @id @default(cuid())
  url       String
  events    String[]
  secret    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("webhooks")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum AdminRole {
  UNASSIGNED
  MASTER_ADMIN
  STORE_MANAGER
  SUPPORT_AGENT
  WAREHOUSE_STAFF
  FINANCE_MANAGER
  MARKETING_MANAGER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
  CANCELLED
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  ITEM_RECEIVED
  INSPECTED
  REFUND_ISSUED
  EXCHANGE_SENT
  CLOSED
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
  BUY_X_GET_Y
}

enum VendorStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  SPAM
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

enum PageStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
}

enum MovementType {
  PURCHASE_RECEIVED
  SALE
  RETURN
  ADJUSTMENT_ADD
  ADJUSTMENT_REMOVE
  DAMAGE
  LOSS
  TRANSFER
}

enum POStatus {
  DRAFT
  SENT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum TransactionType {
  SALE
  REFUND
  PAYOUT
  FEE
  TAX
  ADJUSTMENT
}

enum NotificationType {
  ORDER
  INVENTORY
  RETURN
  REVIEW
  SYSTEM
  MARKETING
  SUPPORT
}
